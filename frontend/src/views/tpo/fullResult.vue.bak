<template>
  <div class="page" style="padding:20px;background:#f7f8fa;min-height:100vh">
    <div style="max-width:700px;margin:0 auto;">
      <div class="page-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
        <span style="font-size:22px;font-weight:600">整套模考成绩</span>
        <el-button @click="$router.push('/tpo/fullRecord')">返回整套记录</el-button>
      </div>
      <el-card shadow="hover" class="score-card" style="border-radius:14px;padding:20px;text-align:center;">
        <div class="score-title" style="font-size:18px;margin-bottom:16px;color:#333">{{info.suiteName}}</div>
        <div class="total-box" style="background:#409eff;color:white;border-radius:12px;padding:16px;margin-bottom:20px;">
          <div style="font-size:14px;opacity:0.9">总分</div>
          <div style="font-size:42px;font-weight:bold;">{{info.totalScore}}</div>
        </div>
        <div class="score-grid" style="display:grid;grid-template-columns: 1fr 1fr 1fr 1fr;gap:12px;">
          <div class="score-item" style="border:1px solid #e5e7eb;border-radius:10px;padding:14px;">
            <div style="display:inline-block;color:#fff;padding:2px 8px;border-radius:6px;font-size:13px;margin-bottom:8px;background:#67c23a;">阅读 R</div>
            <div style="font-size:28px;font-weight:bold;color:#303133;">{{info.readScore}}</div>
          </div>
          <div class="score-item" style="border:1px solid #e5e7eb;border-radius:10px;padding:14px;">
            <div style="display:inline-block;color:#fff;padding:2px 8px;border-radius:6px;font-size:13px;margin-bottom:8px;background:#e6a23c;">听力 L</div>
            <div style="font-size:28px;font-weight:bold;color:#303133;">{{info.listenScore}}</div>
          </div>
          <div class="score-item" style="border:1px solid #e5e7eb;border-radius:10px;padding:14px;">
            <div style="display:inline-block;color:#fff;padding:2px 8px;border-radius:6px;font-size:13px;margin-bottom:8px;background:#f56c6c;">口语 S</div>
            <div style="font-size:28px;font-weight:bold;color:#303133;">{{info.speakScore}}</div>
            <div style="font-size:12px;color:#999;margin-top:4px;">待AI评分</div>
          </div>
          <div class="score-item" style="border:1px solid #e5e7eb;border-radius:10px;padding:14px;">
            <div style="display:inline-block;color:#fff;padding:2px 8px;border-radius:6px;font-size:13px;margin-bottom:8px;background:#909399;">写作 W</div>
            <div style="font-size:28px;font-weight:bold;color:#303133;">{{info.writeScore}}</div>
            <div style="font-size:12px;color:#999;margin-top:4px;">待AI评分</div>
          </div>
        </div>
      </el-card>
    </div>
  </div>
</template>
<script setup>
import {ref,onMounted} from 'vue'
import {useRoute, useRouter} from 'vue-router'
import service from '@/utils/request.js'
import {ElMessage} from 'element-plus'
const route = useRoute()
const router = useRouter()
const info = ref({})

const load = async ()=>{
  try{
    const res = await service.get(`/api/fullSuiteExam/record/${route.query.recordId}`)
    if(res.code===200) info.value = res.data
  }catch(e){
    ElMessage.error("成绩记录不存在")
    router.push('/tpo/fullRecord')
  }
}
onMounted(load)
</script>
