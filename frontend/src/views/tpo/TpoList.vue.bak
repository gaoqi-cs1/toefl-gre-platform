<template>
  <div class="tpo-page">
    <div class="header-box">
      <h1>托福 TPO 刷题平台</h1>
      <div class="user-action">
        <!-- 真题套题：独立数据的新板块，四模块一次性提交 + 口语写作 AI 评分 -->
        <!-- 旧的「真题模考」按钮已移除，全站只保留这一套套题列表 -->
        <el-button type="primary" @click="$router.push('/full')">真题套题</el-button>
        <el-button @click="$router.push('/wrongbook')">错题本</el-button>
        <el-button type="danger" @click="logout">退出登录</el-button>
      </div>
    </div>

    <!-- 四个做题入口平行切换：TOEFL 分块 / TOEFL 套题 / GRE 分块 / GRE 套题 -->
    <div class="mode-switch-wrap"><ModeSwitch /></div>

    <!-- 真题套题入口横幅 -->
    <div class="suite-banner" @click="$router.push('/full')">
      <div class="suite-banner__left">
        <div class="suite-banner__title">真题套题 · 全真四模块模考</div>
        <div class="suite-banner__desc">
          阅读 / 听力 / 口语 / 写作一次做完，答案先存本地，最后统一提交判分；
          口语与写作按新托福 1-6 分档给 AI 评分反馈。
        </div>
      </div>
      <div class="suite-banner__right">
        <span class="suite-banner__cta">进入套题目录 →</span>
      </div>
    </div>

    <el-alert
      v-if="loadError"
      :title="loadError"
      type="warning"
      show-icon
      :closable="false"
      style="max-width:1000px;margin:0 auto 20px;"
    />

    <div class="card-container">
      <!-- 一个模块一张卡片，卡片里列出该模块所有篇章（现在阅读 3 篇、听力 2 篇） -->
      <el-card
        v-for="card in cards"
        :key="card.type"
        class="exam-card"
        shadow="hover"
      >
        <div class="card-head">
          <div class="card-icon">{{ card.icon }}</div>
          <div class="card-head__text">
            <div class="card-title">{{ card.title }}</div>
            <div class="card-desc">{{ card.desc }}</div>
          </div>
          <span class="card-badge">{{ card.sections.length }} 篇</span>
        </div>

        <div class="sec-list">
          <button
            v-for="item in card.sections"
            :key="item.id"
            type="button"
            class="sec-row"
            @click="enterSection(card, item)"
          >
            <span class="sec-row__title">{{ item.title }}</span>
            <span class="sec-row__meta">#{{ item.id }} · {{ item.questionCount }} 题</span>
            <span class="sec-row__arrow">→</span>
          </button>

          <div v-if="card.sections.length === 0" class="sec-empty">
            暂无可用篇章，请先在数据库录入篇章和题目
          </div>
        </div>
      </el-card>
    </div>
  </div>
</template>

<script setup>
import { ref, onMounted } from 'vue'
import { useRouter } from 'vue-router'
import { ElMessage } from 'element-plus'
import service from '@/utils/request.js'
import ModeSwitch from '@/components/ModeSwitch.vue'

const router = useRouter()

/**
 * 四个板块的基础配置。
 * 关键修复：原来这里把 sectionId 写死成 1/2/3/4，
 * 但数据库里真实的篇章只有 1(reading)、4(speaking)、5(writing)、6(reading)、7(listening)，
 * 2 和 3 根本不存在 → 点"听力""口语""写作"进去必然空白。
 * 现在改成进页面时按 type 向 /api/section/list 要真实篇章 id（且有题目的优先）。
 */
const cards = ref([
  { type: 'reading', icon: '📖', title: '阅读 Reading', desc: 'TPO阅读文章 + 选择题练习', routeName: 'ReadingExam', sectionId: null, questionCount: 0, sections: [] },
  { type: 'listening', icon: '🎧', title: '听力 Listening', desc: '音频播放，完成听力题目', routeName: 'ListeningExam', sectionId: null, questionCount: 0, sections: [] },
  { type: 'speaking', icon: '🎤', title: '口语 Speaking', desc: '录音答题，回放自查', routeName: 'SpeakingExam', sectionId: null, questionCount: 0, sections: [] },
  { type: 'writing', icon: '✍️', title: '写作 Writing', desc: '综合写作 & 独立写作作答', routeName: 'WritingExam', sectionId: null, questionCount: 0, sections: [] }
])

const loadError = ref('')

const loadSections = async () => {
  try {
    const res = await service.get('/api/section/list')
    if (res.code !== 200) {
      loadError.value = res.msg || '篇章列表加载失败'
      return
    }
    const sections = res.data || []
    cards.value.forEach(card => {
      const list = sections.filter(s => s.type === card.type)
      // 该模块下所有"有题目"的篇章都列出来（原来只取第一篇，导致第二篇阅读/听力点不到）
      card.sections = list
        .filter(s => (s.questionCount || 0) > 0)
        .map(s => ({ id: s.id, title: s.title, questionCount: s.questionCount || 0 }))
      // 第一张卡片的主篇章：仍然保留 sectionId/questionCount，供统计与兼容旧逻辑使用
      const picked = card.sections[0] || null
      card.sectionId = picked ? picked.id : null
      card.questionCount = picked ? picked.questionCount : 0
    })

    const empty = cards.value.filter(c => !c.sectionId).map(c => c.title)
    if (empty.length) {
      loadError.value = '以下模块数据库中还没有篇章：' + empty.join('、')
    }
  } catch (err) {
    loadError.value = '无法读取题库数据，请确认后端已启动'
    console.error(err)
  }
}

const enterSection = (card, item) => {
  // 点卡片里某一篇 → 只带这一篇的 sectionId 进对应练习页
  if (!item || !item.id) {
    ElMessage.warning(card.title + ' 暂无可用篇章，请先在数据库录入篇章和题目')
    return
  }
  router.push({ name: card.routeName, params: { sectionId: item.id } })
}

const logout = () => {
  localStorage.removeItem('userInfo')
  router.push('/login')
}

onMounted(loadSections)
</script>

<style scoped>
.tpo-page {
  padding: 40px;
}
.header-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
}
.header-box h1 {
  margin: 0;
  color: #333;
}
.user-action {
  display: flex;
  gap: 10px;
}
.card-container {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 28px;
  max-width: 1000px;
  margin: 0 auto;
}

/* 真题套题入口横幅 */
.suite-banner {
  max-width: 1000px;
  margin: 0 auto 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 20px 24px;
  border-radius: 18px;
  cursor: pointer;
  background: linear-gradient(135deg, #17244a 0%, #2b4a8f 62%, #b8791f 130%);
  color: #fff;
  box-shadow: 0 14px 32px rgba(23, 36, 74, 0.22);
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.suite-banner:hover {
  transform: translateY(-2px);
  box-shadow: 0 18px 38px rgba(23, 36, 74, 0.28);
}

.suite-banner__title { font-size: 18px; font-weight: 700; letter-spacing: -0.3px; }

.suite-banner__desc {
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.78);
  max-width: 640px;
}

.suite-banner__right { flex: none; }

.suite-banner__cta {
  display: inline-flex;
  align-items: center;
  height: 36px;
  padding: 0 16px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.16);
  border: 1px solid rgba(255, 255, 255, 0.28);
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
}
/* 模块卡片：上方是模块信息，下方是该模块的篇章列表 */
.exam-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 4px 2px;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.exam-card:hover {
  transform: translateY(-4px);
}
.card-head {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}
.card-head__text { flex: 1; min-width: 0; }
.card-icon {
  font-size: 32px;
  line-height: 1.1;
  flex: none;
}
.card-title {
  font-size: 19px;
  font-weight: 700;
  color: #17244a;
  margin-bottom: 4px;
}
.card-desc {
  color: #6b7a90;
  font-size: 13px;
}
.card-badge {
  flex: none;
  font-size: 12px;
  font-weight: 600;
  color: #b8791f;
  background: rgba(184, 121, 31, 0.12);
  border-radius: 999px;
  padding: 3px 10px;
}

/* 篇章行：整行可点，右侧显示题数，避免"只有第一篇能点" */
.sec-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.sec-row {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 10px 12px;
  border: 1px solid #e6ebf3;
  border-radius: 12px;
  background: #f8fafd;
  cursor: pointer;
  text-align: left;
  font: inherit;
  transition: background 0.16s ease, border-color 0.16s ease, transform 0.16s ease;
}
.sec-row:hover {
  background: #fff;
  border-color: #2b4a8f;
  transform: translateX(2px);
}
.sec-row__title {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  color: #2a3446;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sec-row__meta {
  flex: none;
  font-size: 12px;
  color: #8a99ad;
}
.sec-row__arrow {
  flex: none;
  color: #2b4a8f;
  font-weight: 700;
}
.sec-empty {
  padding: 14px;
  border-radius: 12px;
  background: #fff7e8;
  color: #b8791f;
  font-size: 12px;
  line-height: 1.6;
}
</style>
