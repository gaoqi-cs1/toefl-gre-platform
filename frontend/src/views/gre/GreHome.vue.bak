<template>
  <AppShell>
    <div class="page">
      <!-- GRE 主视觉板块（显眼入口：数据概览 + 两个主动作 + 错题本入口） -->
      <section class="gre-hero">
        <div class="gre-hero__glow" aria-hidden="true"></div>
        <div class="gre-hero__left">
          <span class="gre-hero__eyebrow">GRADUATE RECORD EXAMINATIONS</span>
          <h1 class="gre-hero__title">GRE 备考中心</h1>
          <p class="gre-hero__sub">
            两个入口、两套独立数据：分块练习按题型逐个击破，全真套题按真实考试顺序整卷作答。
            练习改了不会影响已生成的套题；做错的题会自动进错题本，答对一次就移出。
          </p>
          <div class="gre-hero__actions">
            <el-button type="primary" size="large" round @click="scrollToPractice">开始分块练习</el-button>
            <el-button size="large" round :loading="generating" @click="generateSuite">一键生成套题</el-button>
            <button type="button" class="gre-hero__wrong" @click="goWrongBook">
              <span>GRE 错题本</span>
              <em>{{ wrongTotal }}</em>
            </button>
          </div>
        </div>
        <div class="gre-hero__stats">
          <div class="hero-stat"><strong>{{ catalog.totalQuestions || 0 }}</strong><span>练习题</span></div>
          <div class="hero-stat"><strong>{{ catalog.sectionCount || 0 }}</strong><span>练习单元</span></div>
          <div class="hero-stat"><strong>{{ suites.length }}</strong><span>可用套题</span></div>
          <div class="hero-stat"><strong>{{ wrongTotal }}</strong><span>待复习错题</span></div>
        </div>
      </section>


      <!-- 分块练习 -->
      <section id="practice-block" class="block">
        <div class="block__head">
          <h2 class="section-title">分块练习</h2>
          <span class="muted">共 {{ catalog.totalQuestions || 0 }} 题 · {{ catalog.sectionCount || 0 }} 个练习单元</span>
        </div>

        <div v-loading="loadingCatalog" class="module-grid">
          <article v-for="mod in catalog.modules" :key="mod.moduleType" class="module-card card">
            <header class="module-card__head">
              <div>
                <h3>{{ mod.label }}</h3>
                <p class="muted">{{ moduleHint(mod.moduleType) }}</p>
              </div>
              <span class="module-card__count">{{ mod.questionCount }} 题</span>
            </header>

            <ul class="section-list">
              <li v-for="section in mod.sections" :key="section.sectionId">
                <button type="button" class="section-item" @click="openPractice(section)">
                  <span class="section-item__main">
                    <strong>{{ section.title }}</strong>
                    <small>{{ section.subtitle }}</small>
                  </span>
                  <span class="section-item__meta">
                    <span class="tag">{{ section.difficulty }}</span>
                    <span class="tag tag--ghost">{{ section.questionCount }} 题</span>
                    <span v-if="section.hasPassage" class="tag tag--accent">含文章</span>
                  </span>
                </button>
              </li>
            </ul>
          </article>

          <div v-if="!loadingCatalog && (!catalog.modules || catalog.modules.length === 0)" class="empty card card-pad">
            还没有分块题库，请先执行项目根目录的 db-gre-module.sql。
          </div>
        </div>
      </section>

      <!-- 全真套题 -->
      <section id="suite-block" class="block">
        <div class="block__head">
          <h2 class="section-title">全真套题</h2>
          <span class="muted">Writing → Verbal → Quant 顺序作答，最后一次性提交判分</span>
        </div>

        <div v-loading="loadingSuites" class="suite-grid">
          <article v-for="suite in suites" :key="suite.id" class="suite-card card">
            <div class="suite-card__top">
              <span class="suite-card__badge">{{ suite.difficulty || '中级' }}</span>
              <span class="suite-card__minutes">{{ suite.totalMinutes }} 分钟</span>
            </div>

            <h3 class="suite-card__title">{{ suite.title }}</h3>
            <p class="suite-card__desc">{{ suite.description }}</p>

            <div class="suite-card__stats">
              <div class="stat"><strong>{{ suite.writingCount || 0 }}</strong><span>写作</span></div>
              <div class="stat"><strong>{{ suite.verbalCount || 0 }}</strong><span>Verbal</span></div>
              <div class="stat"><strong>{{ suite.quantCount || 0 }}</strong><span>Quant</span></div>
              <div class="stat"><strong>{{ suite.questionCount || 0 }}</strong><span>总题量</span></div>
            </div>

            <div class="suite-card__foot">
              <el-button type="primary" round :loading="startingId === suite.id" @click="startExam(suite)">
                开始模考
              </el-button>
              <el-button
                v-if="suite.source === 'generated'"
                text
                type="danger"
                size="small"
                @click="removeSuite(suite)"
              >删除</el-button>
            </div>
          </article>

          <div v-if="!loadingSuites && suites.length === 0" class="empty card card-pad">
            还没有 GRE 套题，点右上角「一键生成套题」从分块题库随机组一套。
          </div>
        </div>
      </section>

      <!-- 我的记录 -->
      <section class="records card card-pad">
        <div class="records__head">
          <h3 class="section-title">我的 GRE 模考记录</h3>
          <el-button text type="primary" @click="loadRecords">刷新</el-button>
        </div>

        <el-table v-if="records.length" :data="records" style="width: 100%" empty-text="暂无记录">
          <el-table-column prop="suiteTitle" label="套题" min-width="200" />
          <el-table-column label="状态" width="110">
            <template #default="{ row }">
              <span :class="['pill', row.status === 'finished' ? 'pill--ok' : 'pill--muted']">
                {{ row.status === 'finished' ? '已完成' : '作答中' }}
              </span>
            </template>
          </el-table-column>
          <el-table-column label="总分" width="110">
            <template #default="{ row }">
              <span v-if="row.status === 'finished'" class="score-badge">{{ row.totalScore }}</span>
              <span v-else class="muted">—</span>
            </template>
          </el-table-column>
          <el-table-column label="V / Q" width="120">
            <template #default="{ row }">
              <span v-if="row.status === 'finished'">{{ row.verbalScaled }} / {{ row.quantScaled }}</span>
              <span v-else class="muted">—</span>
            </template>
          </el-table-column>
          <el-table-column label="AWA" width="90">
            <template #default="{ row }">
              <span v-if="row.awaScore != null">{{ row.awaScore }}<small>/6</small></span>
              <span v-else class="muted">—</span>
            </template>
          </el-table-column>
          <el-table-column label="用时" width="110">
            <template #default="{ row }">
              {{ row.costSeconds ? formatDuration(row.costSeconds) : '—' }}
            </template>
          </el-table-column>
          <el-table-column label="开始时间" min-width="150">
            <template #default="{ row }">{{ formatTime(row.startTime) }}</template>
          </el-table-column>
          <el-table-column label="操作" width="210" align="right">
            <template #default="{ row }">
              <el-button v-if="row.status === 'finished'" size="small" round @click="viewResult(row)">
                查看成绩
              </el-button>
              <el-button v-else size="small" type="primary" round @click="resumeExam(row)">继续作答</el-button>
              <el-button size="small" text type="danger" @click="removeRecord(row)">删除</el-button>
            </template>
          </el-table-column>
        </el-table>

        <div v-else class="empty">还没有 GRE 模考记录，先选一套开始。</div>
      </section>
    </div>
  </AppShell>
</template>

<script setup>
/**
 * GRE 首页：分块练习目录 + 套题目录 + 我的模考记录
 *
 * 数据来源（全部是 GRE 自己的接口，不调用任何 TOEFL 接口）：
 *   GET  /api/gre/practice/catalog   分块目录
 *   GET  /api/greSuite/list          套题目录
 *   GET  /api/greExam/records        我的模考记录
 *   POST /api/greSuite/generate      一键生成
 *   POST /api/greExam/start          开始模考
 */
import { onMounted, ref } from 'vue'
import { useRouter } from 'vue-router'
import { ElMessage, ElMessageBox } from 'element-plus'
import request from '@/utils/request'
import AppShell from '@/components/AppShell.vue'

const router = useRouter()

const catalog = ref({ modules: [], totalQuestions: 0, sectionCount: 0 })
const suites = ref([])
const records = ref([])
const loadingCatalog = ref(false)
const loadingSuites = ref(false)
const generating = ref(false)
const startingId = ref(null)
const userId = ref(1)
const wrongTotal = ref(0)

function loadUser() {
  const str = localStorage.getItem('userInfo')
  if (!str) return
  try {
    const info = JSON.parse(str)
    if (info.userId) userId.value = info.userId
  } catch (e) {
    // 解析失败用兜底 1
  }
}

async function loadCatalog() {
  loadingCatalog.value = true
  try {
    const res = await request.get('/api/gre/practice/catalog')
    if (res.code === 200) catalog.value = res.data || { modules: [] }
  } catch (e) {
    // 拦截器已提示
  } finally {
    loadingCatalog.value = false
  }
}

async function loadSuites() {
  loadingSuites.value = true
  try {
    const res = await request.get('/api/greSuite/list')
    if (res.code === 200) suites.value = res.data || []
  } catch (e) {
    // 拦截器已提示
  } finally {
    loadingSuites.value = false
  }
}

async function loadRecords() {
  try {
    const res = await request.get('/api/greExam/records', { params: { userId: userId.value } })
    if (res.code === 200) records.value = res.data || []
  } catch (e) {
    // 忽略
  }
}

function scrollToPractice() {
  const el = document.getElementById('practice-block')
  if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' })
}

function goWrongBook() {
  router.push('/gre/wrong')
}

/** 只拿统计，用来在 hero 上显示待复习错题角标（失败不影响首页其它内容） */
async function loadWrongTotal() {
  try {
    const res = await request.get('/api/greWrong/list', { params: { userId: userId.value } })
    if (res.code === 200 && res.data && res.data.stats) {
      const s = res.data.stats
      wrongTotal.value = (s.verbal || 0) + (s.quant || 0) + (s.writing || 0)
    }
  } catch (e) {
    // 错题统计失败静默处理
  }
}

async function generateSuite() {
  generating.value = true
  try {
    const res = await request.post('/api/greSuite/generate', { writing: 2, verbal: 10, quant: 10 })
    if (res.code !== 200) {
      ElMessage.error(res.msg || '生成失败')
      return
    }
    const d = res.data || {}
    ElMessage.success(`已生成「${d.title}」：写作 ${d.writingCount} 篇 / Verbal ${d.verbalCount} 题 / Quant ${d.quantCount} 题`)
    await loadSuites()
  } catch (e) {
    // 拦截器已提示
  } finally {
    generating.value = false
  }
}

async function removeSuite(suite) {
  try {
    await ElMessageBox.confirm('删除这套随机生成的套题？预置套题不受影响。', '删除确认', {
      type: 'warning',
      confirmButtonText: '删除',
      cancelButtonText: '取消'
    })
  } catch (e) {
    return
  }
  try {
    const res = await request.delete('/api/greSuite/' + suite.id)
    if (res.code === 200) {
      ElMessage.success('已删除')
      loadSuites()
    } else {
      ElMessage.error(res.msg || '删除失败')
    }
  } catch (e) {
    // 拦截器已提示
  }
}

function openPractice(section) {
  router.push({ path: '/gre/practice/' + section.sectionId })
}

async function startExam(suite) {
  startingId.value = suite.id
  try {
    const res = await request.post('/api/greExam/start', { suiteId: suite.id, userId: userId.value })
    if (res.code !== 200) {
      ElMessage.error(res.msg || '开始失败')
      return
    }
    const record = res.data
    clearLocalCache(record.id)
    router.push({ path: '/gre/exam', query: { recordId: record.id, suiteId: suite.id } })
  } catch (e) {
    // 拦截器已提示
  } finally {
    startingId.value = null
  }
}

function resumeExam(row) {
  router.push({ path: '/gre/exam', query: { recordId: row.id, suiteId: row.suiteId } })
}

function viewResult(row) {
  router.push({ path: '/gre/result', query: { recordId: row.id } })
}

async function removeRecord(row) {
  try {
    await ElMessageBox.confirm('删除这条记录后无法恢复（含逐题作答与 AWA 反馈），确定删除吗？', '删除确认', {
      type: 'warning',
      confirmButtonText: '删除',
      cancelButtonText: '取消'
    })
  } catch (e) {
    return
  }
  try {
    const res = await request.delete('/api/greExam/record/' + row.id)
    if (res.code === 200) {
      clearLocalCache(row.id)
      ElMessage.success('已删除')
      loadRecords()
    } else {
      ElMessage.error(res.msg || '删除失败')
    }
  } catch (e) {
    // 拦截器已提示
  }
}

/* GRE 的本地缓存用 greExam:* 前缀，和 TOEFL 的 fullExam:* 完全分开 */
function clearLocalCache(recordId) {
  localStorage.removeItem('greExam:answers:' + recordId)
  localStorage.removeItem('greExam:startedAt:' + recordId)
}

function moduleHint(moduleType) {
  if (moduleType === 'writing') return '30 分钟一篇，AI 按 0-6 档评分'
  if (moduleType === 'verbal') return '填空 / 六选一 / 阅读，正确率换算 130-170'
  if (moduleType === 'quant') return '数量比较 / 问题求解，正确率换算 130-170'
  return ''
}

function formatDuration(seconds) {
  const h = Math.floor(seconds / 3600)
  const m = Math.floor((seconds % 3600) / 60)
  const s = seconds % 60
  return h > 0 ? `${h} 小时 ${m} 分` : `${m} 分 ${s} 秒`
}

function formatTime(value) {
  if (!value) return '—'
  return String(value).replace('T', ' ').slice(0, 16)
}

onMounted(() => {
  loadUser()
  loadCatalog()
  loadSuites()
  loadRecords()
  loadWrongTotal()
})
</script>

<style scoped>
.head-actions { display: flex; align-items: center; gap: 10px; }
.block { margin-bottom: 30px; }
.block__head {
  display: flex;
  align-items: baseline;
  gap: 14px;
  margin-bottom: 14px;
}
.block__head .section-title { margin-bottom: 0; }

.module-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
  gap: 18px;
}

.module-card { padding: 20px 22px; }

.module-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 14px;
}

.module-card__head h3 {
  margin: 0 0 4px;
  font-size: 18px;
  letter-spacing: -0.2px;
}

.module-card__head p { margin: 0; font-size: 12px; }

.module-card__count {
  font-size: 12px;
  font-weight: 700;
  color: var(--brand-600);
  background: var(--brand-50);
  padding: 4px 10px;
  border-radius: 999px;
  white-space: nowrap;
}

.section-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.section-item {
  width: 100%;
  appearance: none;
  text-align: left;
  border: 1px solid var(--line);
  background: var(--surface-2);
  border-radius: var(--radius-md);
  padding: 12px 14px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
}

.section-item:hover {
  background: #fff;
  border-color: var(--brand-100);
  transform: translateY(-1px);
}

.section-item__main { display: flex; flex-direction: column; gap: 2px; }
.section-item__main strong { font-size: 14px; }
.section-item__main small { font-size: 12px; color: var(--ink-500); }

.section-item__meta { display: flex; gap: 6px; flex-wrap: wrap; }

.tag {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 999px;
  background: #fff;
  border: 1px solid var(--line);
  color: var(--ink-500);
}

.tag--ghost { color: var(--ink-500); }
.tag--accent { background: var(--accent-100); border-color: transparent; color: var(--accent-600); font-weight: 700; }

.suite-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 18px;
}

.suite-card {
  padding: 20px 22px 16px;
  display: flex;
  flex-direction: column;
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.suite-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }

.suite-card__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }

.suite-card__badge {
  display: inline-flex;
  align-items: center;
  height: 24px;
  padding: 0 10px;
  border-radius: 999px;
  background: var(--accent-100);
  color: var(--accent-600);
  font-size: 12px;
  font-weight: 700;
}

.suite-card__minutes { font-size: 12px; color: var(--ink-500); }

.suite-card__title { margin: 0 0 8px; font-size: 20px; font-weight: 700; letter-spacing: -0.3px; }

.suite-card__desc { margin: 0 0 14px; font-size: 13px; line-height: 1.65; color: var(--ink-500); min-height: 42px; }

.suite-card__stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  padding: 12px;
  border-radius: var(--radius-md);
  background: var(--surface-2);
  border: 1px solid var(--line);
}

.stat { display: flex; flex-direction: column; align-items: center; gap: 2px; }
.stat strong { font-size: 18px; font-variant-numeric: tabular-nums; color: var(--brand-700); }
.stat span { font-size: 11px; color: var(--ink-500); }

.suite-card__foot {
  margin-top: 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.records__head { display: flex; align-items: center; justify-content: space-between; }
.records__head :deep(.section-title) { margin-bottom: 0; }
.records :deep(.el-table) { margin-top: 12px; }
.records :deep(.el-table th) { background: var(--surface-2) !important; color: var(--ink-700); font-weight: 600; }

.score-badge { font-size: 18px; font-weight: 800; color: var(--brand-700); font-variant-numeric: tabular-nums; }
.score-badge small { font-size: 11px; color: var(--ink-300); }
.muted { color: var(--ink-300); }

/* ===== GRE 主视觉板块 ===== */
.gre-hero {
  position: relative;
  overflow: hidden;
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
  gap: 28px;
  align-items: center;
  padding: 34px 36px;
  margin-bottom: 28px;
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, #10214a 0%, #1b3566 46%, #27468c 100%);
  box-shadow: 0 22px 48px rgba(16, 33, 74, 0.28);
  color: #fff;
}

.gre-hero__glow {
  position: absolute;
  width: 460px;
  height: 460px;
  right: -120px;
  top: -180px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 66%);
  pointer-events: none;
}

.gre-hero__left { position: relative; z-index: 1; }

.gre-hero__eyebrow {
  display: inline-block;
  font-size: 11px;
  letter-spacing: 2.4px;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.62);
  margin-bottom: 10px;
}

.gre-hero__title {
  margin: 0 0 12px;
  font-size: 34px;
  line-height: 1.15;
  font-weight: 800;
  letter-spacing: -0.6px;
}

.gre-hero__sub {
  margin: 0 0 20px;
  max-width: 620px;
  font-size: 14px;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.78);
}

.gre-hero__actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

.gre-hero__wrong {
  appearance: none;
  border: 1px solid rgba(255, 255, 255, 0.28);
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border-radius: 999px;
  padding: 11px 18px;
  font-size: 14px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  transition: background 0.16s ease, border-color 0.16s ease;
}

.gre-hero__wrong:hover { background: rgba(255, 255, 255, 0.18); border-color: rgba(255, 255, 255, 0.5); }

.gre-hero__wrong em {
  font-style: normal;
  min-width: 22px;
  height: 22px;
  padding: 0 6px;
  border-radius: 999px;
  background: #f0b64a;
  color: #2b1a00;
  font-size: 12px;
  font-weight: 800;
  display: inline-grid;
  place-items: center;
  font-variant-numeric: tabular-nums;
}

.gre-hero__stats {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.hero-stat {
  padding: 16px 18px;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(6px);
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.hero-stat strong { font-size: 26px; font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }
.hero-stat span { font-size: 12px; color: rgba(255, 255, 255, 0.66); }

@media (max-width: 960px) {
  .gre-hero { grid-template-columns: 1fr; padding: 26px 22px; }
  .gre-hero__title { font-size: 27px; }
}
</style>
